{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prd.eonhive.dev/schemas/content.schema.json",
  "title": "PRD General-Document Content",
  "description": "Canonical document-root shapes, supported content nodes and packaged section-root definition. Package-level relationships still require semantic validation.",
  "type": "object",
  "required": [
    "schemaVersion",
    "profile",
    "type",
    "id",
    "title",
    "children"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schemaVersion": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "profile": {
      "const": "general-document"
    },
    "type": {
      "const": "document"
    },
    "id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "title": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "subtitle": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "summary": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "lang": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/topLevelNode"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "sectionNode": {
      "type": "object",
      "required": [
        "type",
        "id",
        "title",
        "children"
      ],
      "properties": {
        "type": {
          "const": "section"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "src": false
      },
      "additionalProperties": true
    },
    "headingNode": {
      "type": "object",
      "required": [
        "type",
        "level",
        "text"
      ],
      "properties": {
        "type": {
          "const": "heading"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": true
    },
    "paragraphNode": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": true
    },
    "listNode": {
      "type": "object",
      "required": [
        "type",
        "style",
        "items"
      ],
      "properties": {
        "type": {
          "const": "list"
        },
        "style": {
          "type": "string",
          "enum": [
            "unordered",
            "ordered"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": true
    },
    "imageNode": {
      "type": "object",
      "required": [
        "type",
        "asset",
        "alt"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "asset": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "alt": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "caption": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": true
    },
    "quoteNode": {
      "type": "object",
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "quote"
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "attribution": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": true
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/sectionNode"
        },
        {
          "$ref": "#/$defs/headingNode"
        },
        {
          "$ref": "#/$defs/paragraphNode"
        },
        {
          "$ref": "#/$defs/listNode"
        },
        {
          "$ref": "#/$defs/linksNode"
        },
        {
          "$ref": "#/$defs/tableNode"
        },
        {
          "$ref": "#/$defs/chartNode"
        },
        {
          "$ref": "#/$defs/mediaNode"
        },
        {
          "$ref": "#/$defs/imageNode"
        },
        {
          "$ref": "#/$defs/quoteNode"
        }
      ]
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "segmentedSectionNode": {
      "type": "object",
      "required": [
        "type",
        "id",
        "title",
        "src"
      ],
      "properties": {
        "type": {
          "const": "section"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "src": {
          "type": "string",
          "pattern": "^content/sections/.+\\.json$"
        },
        "children": false
      },
      "additionalProperties": true
    },
    "linksNode": {
      "type": "object",
      "required": [
        "type",
        "style",
        "items"
      ],
      "properties": {
        "type": {
          "const": "links"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "style": {
          "enum": [
            "list",
            "inline"
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "href"
            ],
            "properties": {
              "label": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "href": {
                "type": "string",
                "pattern": "^(https?:\\/\\/\\S+|mailto:\\S+|tel:\\S+|#\\S+)$"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "tableNode": {
      "type": "object",
      "required": [
        "type",
        "columns",
        "rows"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "caption": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "label": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "align": {
                "enum": [
                  "left",
                  "center",
                  "right"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "rows": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": true
    },
    "chartNode": {
      "type": "object",
      "required": [
        "type",
        "chartType",
        "categories",
        "series"
      ],
      "properties": {
        "type": {
          "const": "chart"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "chartType": {
          "const": "bar"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "caption": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "values"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/nonEmptyString"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "mediaNode": {
      "type": "object",
      "required": [
        "type",
        "mediaType",
        "asset"
      ],
      "properties": {
        "type": {
          "const": "media"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mediaType": {
          "enum": [
            "audio",
            "video"
          ]
        },
        "asset": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "poster": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "caption": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "mediaType": {
                "const": "audio"
              }
            },
            "required": [
              "mediaType"
            ]
          },
          "then": {
            "properties": {
              "poster": false
            }
          }
        }
      ]
    },
    "topLevelNode": {
      "oneOf": [
        {
          "$ref": "#/$defs/node"
        },
        {
          "$ref": "#/$defs/segmentedSectionNode"
        }
      ]
    },
    "documentSectionRoot": {
      "type": "object",
      "required": [
        "schemaVersion",
        "profile",
        "type",
        "id",
        "title",
        "children"
      ],
      "properties": {
        "$schema": {
          "type": "string",
          "format": "uri-reference"
        },
        "schemaVersion": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "profile": {
          "const": "general-document"
        },
        "type": {
          "const": "document-section"
        },
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "$comment": "Unknown properties are retained for compatibility but do not declare executable behavior. The default target is a document root; section files use #/$defs/documentSectionRoot."
}
