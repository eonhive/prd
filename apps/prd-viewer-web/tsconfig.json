{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "references": [
    {
      "path": "../../packages/prd-types"
    },
    {
      "path": "../../packages/prd-validator"
    },
    {
      "path": "../../packages/prd-viewer-core"
    },
    {
      "path": "../../packages/prd-converter"
    }
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts"
  ]
}
